FRESHFLOW_ENV=local
FRESHFLOW_LOG_LEVEL=info
FRESHFLOW_HTTP_ADDR=:8080
FRESHFLOW_CATALOG_SERVICE_URL=http://localhost:8081
FRESHFLOW_CART_SERVICE_URL=http://localhost:8082
FRESHFLOW_ORDER_SERVICE_URL=http://localhost:8083
FRESHFLOW_DELIVERY_SERVICE_URL=http://localhost:8084
FRESHFLOW_ANALYTICS_SERVICE_URL=http://localhost:8087
FRESHFLOW_ETA_SERVICE_URL=http://localhost:8090
FRESHFLOW_POSTGRES_DSN=postgres://freshflow:freshflow@localhost:5432/freshflow?sslmode=disable
FRESHFLOW_REDIS_ADDR=localhost:6379
FRESHFLOW_REDIS_PASSWORD=
FRESHFLOW_REDIS_DB=0
FRESHFLOW_KAFKA_BROKERS=localhost:9092
FRESHFLOW_KAFKA_GROUP=freshflow.notification-worker.v1
FRESHFLOW_CLICKHOUSE_ADDR=localhost:9000
FRESHFLOW_CLICKHOUSE_DATABASE=freshflow
FRESHFLOW_CLICKHOUSE_USER=freshflow
FRESHFLOW_CLICKHOUSE_PASSWORD=freshflow
FRESHFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
FRESHFLOW_OTEL_SAMPLE_RATIO=1
FRESHFLOW_STARTUP_TIMEOUT=15s
FRESHFLOW_DEPENDENCY_CHECK_TIMEOUT=2s
FRESHFLOW_SHUTDOWN_TIMEOUT=10s
