{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freshflow.local/schemas/events/envelope.v1.schema.json",
  "title": "FreshFlow event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "aggregate_id", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "minLength": 1},
    "event_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string"},
    "trace_id": {"type": "string"},
    "span_id": {"type": "string"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "payload": {"type": "object"}
  }
}
