{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freshflow.local/schemas/events/inventory.reserved.v1.payload.schema.json",
  "title": "inventory.reserved v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["reservation_id", "checkout_attempt_id", "items", "expires_at"],
  "properties": {
    "reservation_id": {"type": "string", "format": "uuid"},
    "checkout_attempt_id": {"type": "string", "format": "uuid"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product_id", "quantity"],
        "properties": {
          "product_id": {"type": "string", "format": "uuid"},
          "quantity": {"type": "integer", "minimum": 1}
        }
      }
    },
    "expires_at": {"type": "string", "format": "date-time"}
  }
}

